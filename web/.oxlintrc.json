{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "react"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error"
  },
  "overrides": [
    {
      "files": ["src/screens/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./",
                "message": "A screen imports its own files as ./x and everything else through @/."
              },
              {
                "regex": "^@/screens/",
                "message": "A screen never imports another screen."
              }
            ]
          }
        ]
      }
    }
  ]
}
